# =====================================================================
# Smart Hostel Room Allocation System - environment variables
#
# Copy this file to `.env` in the same folder and fill in real values:
#     cp .env.example .env        (macOS / Linux)
#     copy .env.example .env      (Windows CMD)
#
# `.env` is listed in .gitignore and must NEVER be committed to Git.
# This file (.env.example) IS committed, so anyone cloning the project
# knows which variables they need to supply.
# =====================================================================

# --- Server -----------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MySQL database ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_hostel
DB_CONNECTION_LIMIT=10

# --- Session ----------------------------------------------------------
# A long random string. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string
SESSION_MAX_AGE_MS=7200000

# --- Paystack (test/sandbox keys only during development) -------------
# Get these from https://dashboard.paystack.com/#/settings/developers
# The SECRET key is used ONLY on the server. Never send it to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Where Paystack sends the student back after payment.
APP_BASE_URL=http://localhost:5000
PAYMENT_CALLBACK_URL=http://localhost:5000/student/payment-callback.html

# --- First administrator account (used by: npm run seed:admin) --------
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@university.edu.ng
SEED_ADMIN_PASSWORD=ChangeMe_123!

# --- Security (optional) ----------------------------------------------
# SESSION_SECRET must be at least 32 characters; the server refuses to start otherwise.
# Set TRUST_PROXY ONLY when the app really runs behind reverse proxies: the number of proxies
# in front of it (for example 1), or loopback. Leave it unset for direct access. "true" is refused.
# TRUST_PROXY=1
# Login rate limit (defaults: 5 attempts per account+IP and 30 per IP, per 15 minutes).
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_ACCOUNT=5
# LOGIN_RATE_MAX_PER_IP=30
